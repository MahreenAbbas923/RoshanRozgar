# Server port
PORT=5000

# Secret used to sign login tokens. Change this in any shared deployment.
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB connection string. Leave empty to run in DEMO MODE, which stores
# data in server/data/demo-db.json with the same seeded data.
MONGODB_URI=

# Optional: Anthropic API key. When set, job understanding, chat translation
# and review summaries use Claude. When empty, the app uses its built-in
# keyword matcher and says so in the UI.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Allowed browser origin for the API (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Groq API key. Enables server speech-to-text (Whisper, supports Urdu)
# and LLM features when no Anthropic key is set.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b
